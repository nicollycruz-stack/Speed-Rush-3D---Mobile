,\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"3406576223\":{\"name\":\"3406576223\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"instructions\":\"The user selected Create goal. Create a saved goal with a plan for their request. Use the request_user_input tool for setup questions so the user can answer in the question UI. Ask up to three focused questions together: the first check-in date and time if missing, and only essential details needed to shape the goal. Offer concrete choices and allow a custom answer. A trip date or goal deadline is not a check-in time. Wait for the answers, then create the goal using the automations tool with a nonempty plan and the agreed schedule before doing detailed planning. Keep remaining optional details as open questions in the plan; do not require another round of planning questions before saving. Do not invent a check-in time or add recurrence without agreement. If saving fails, explain the error and ask only for what is needed to fix it. Confirm only after saving succeeds, and update the same goal in later replies instead of creating duplicates. Keep implementation details and tool names out of user-facing replies.\"},\"is_device_based\":false,\"passed\":false},\"3452582515\":{\"name\":\"3452582515\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":13,\"id_type\":\"userID\",\"value\":{\"connectors\":{\"connector_openai_olympic\":{\"widgetType\":\"olympic\",\"host\":\"health_onboarding\",\"template\":\"internal://olympic\",\"viewParams\":{\"view\":\"onboarding_v3\"}}}},\"is_device_based\":false,\"passed\":false},\"3453049041\":{\"name\":\"3453049041\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"title\":\"Rosalind Workbench\",\"acknowledgement_button_text\":\"Get started\",\"background_asset\":\"rosalind-helix\",\"subtitle\":\"Perform scientific research with fr