ue\":{\"section_order\":[]},\"is_device_based\":false,\"passed\":false},\"3999280432\":{\"name\":\"3999280432\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":14,\"id_type\":\"userID\",\"value\":{\"url\":\"https://help.openai.com/articles/20001423\"},\"is_device_based\":false,\"passed\":false},\"4023951618\":{\"name\":\"4023951618\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"4051280260\":{\"name\":\"4051280260\",\"rule_id\":\"69yI5mTCm3JoNFg7p7E6Ha:100.00:2-69yI5lezTLzUufIbNZIto8\",\"secondary_exposures\":[{\"gate\":\"3856949927\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":111,\"id_type\":\"userID\",\"value\":{\"templates\":[{\"prompt\":\"Check my relevant connected apps and create a to-do checklist. Automatically update every morning at 6am in my browser time zone: check off completed tasks for me, and carry forward incomplete tasks to the next day.\",\"prefillPrompt\":\"Help me turn this Page into my to-do list. Check relevant conversations and connected apps you can access for things I need to do. If you can’t find enough, ask me what to add. Replace the sample tasks, keep the checkboxes and any edits I’ve made, and don’t invent tasks or deadlines.\",\"id\":\"to-do-list\",\"previewMarkdown\":\"## Today\\n\\n### Top priorities\\n\\n- [ ] Run propulsion test\\n\\n- [ ] Verify course calculations\\n\\n- [ ] Inspect fuel tanks\\n\\n### If time allows\\n\\n- [ ] Inspect radiation shields\\n\\n- [ ] Test communication systems\\n\\n- [ ] Write status report\",\"title\":\"To-do list\"},{\"prefillPrompt\":\"Help me make this Page a tracker for my project. Use relevant conversations and connected apps you can access to find milestones and tasks, and ask me for anything missing. Replace the examples, keep my edits, and don’t guess at owners, dates, or statuses.\",\"previewMarkdown\":\"## 🔴 Needs immediate attention\\n\\n- Communication systems test for launch\\n\\n## ⛰️ Milestones\\n\\n| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\\n\\n## ✅ Tasks\\n\\n| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"## 🔴 Needs immediate attention\"},{\"markdown\":\"- Communication systems test for launch\",\"kind\":\"markdown\"},{\"markdown\":\"## ⛰️ Milestones\",\"kind\":\"markdown\"},{\"layout\":\"flexible\",\"kind\":\"markdown\",\"markdown\":\"| Milestone | Status |\\n| - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eProject brief\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Complete |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrototype review\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eLaunch readiness\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Upcoming |\"},{\"kind\":\"markdown\",\"markdown\":\"## ✅ Tasks\"},{\"markdown\":\"| Task | Owner | Status |\\n| - | - | - |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eConfirm scope\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Product | Done |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eReview designs\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Design | In progress |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003eTest the core flow\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Engineering | Next |\\n| \u003cul\u003e\u003cli data-checked=\\\"false\\\"\u003e\u003cp\u003ePrepare launch notes\u003c/p\u003e\u003c/li\u003e\u003c/ul\u003e | Marketing | Next |\",\"kind\":\"markdown\",\"layout\":\"flexible\"}],\"followUp\":{\"questions\":[{\"question\":\"Which project do you want to track?\",\"answerLabel\":\"Project\",\"options\":[]},{\"answerLabel\":\"Goal or deadline\",\"question\":\"What’s the main outcome or deadline for this project?\",\"options\":[]}],\"preparingLabel\":\"Getting your tracker ready…\",\"submitLabel\":\"Create tracker\"},\"id\":\"project-tracker\",\"title\":\"Project tracker\",\"prompt\":\"Check my relevant connected apps and create a project tracker. Automatically update every morning at 6am in my browser time zone.\"},{\"previewMarkdown\":\"## ✨ Highlights\\n\\n- Progress made\\n\\n## ☝️ Needs attention\\n\\n- Blockers and decisions needing input\\n\\n## ▶️ Next week\\n\\n- Upcoming milestones and confirmed commitments\\n\\n## 🔗 Sources\\n\\n- Links to sources\",\"id\":\"weekly-update\",\"prefillPrompt\":\"Help me write this week’s update on this Page. Look for progress, blockers, and next steps in relevant conversations and connected apps you can access. Ask which project or week I mean if it’s unclear, and don’t make up accomplishments.\",\"title\":\"Weekly update\",\"followUp\":{\"preparingLabel\":\"Getting your update ready…\",\"freeformPlaceholder\":\"e.g. My work, the design team, or the website launch\",\"submitLabel\":\"Create update\",\"questions\":[{\"options\":[],\"question\":\"What should this week's update cover?\",\"answerLabel\":\"Update scope\"}]},\"prompt\":\"Check my relevant connected apps and create a weekly update suitable for sharing with cross-functional partners, stakeholders, and executives.\"},{\"followUp\":{\"freeformPlaceholder\":\"e.g. The new onboarding flow\",\"preparingLabel\":\"Getting your feedback tracker ready…\",\"submitLabel\":\"Create feedback tracker\",\"questions\":[{\"question\":\"What product or feature should we collect feedback on?\",\"answerLabel\":\"Product or feature\",\"options\":[]},{\"options\":[{\"value\":\"Customers and users\",\"id\":\"customers\"},{\"id\":\"internal-testers\",\"value\":\"Internal testers\"},{\"id\":\"both\",\"value\":\"Both\"}],\"answerLabel\":\"Feedback sources\",\"isOther\":true,\"question\":\"Whose feedback should we include?\"}]},\"prompt\":\"Check my relevant connected apps and create a feedback tracker. Ask which project I would like to track feedback for. Automatically update every morning at 6am in my browser time zone.\",\"prefillPrompt\":\"Help me organize feedback on this Page. Use relevant conversations and connected apps you can access to find feedback. Ask what product or topic to focus on if it’s unclear, replace the examples with what you find, and don’t invent feedback.\",\"previewDocument\":[{\"kind\":\"markdown\",\"markdown\":\"## 🔎 Top themes\"},{\"kind\":\"markdown\",\"markdown\":\"1. Make onboarding easier to follow\"},{\"markdown\":\"2. Help people find the right resource\",\"kind\":\"markdown\"},{\"markdown\":\"3. Clarify what happens after sharing\",\"kind\":\"markdown\"},{\"kind\":\"markdown\",\"markdown\":\"## 🗂️ Feedback register\"},{\"layout\":\"flexible\",\"kind\":\"markdown\",\"markdown\":\"| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\"},{\"kind\":\"markdown\",\"markdown\":\"## 📝 Summary\"},{\"markdown\":\"People need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\",\"kind\":\"markdown\"},{\"markdown\":\"## ▶️ Follow-ups\",\"kind\":\"markdown\"},{\"markdown\":\"- Schedule user interviews for next week\",\"kind\":\"markdown\"}],\"previewMarkdown\":\"## 🔎 Top themes\\n\\n1. Make onboarding easier to follow\\n\\n2. Help people find the right resource\\n\\n3. Clarify what happens after sharing\\n\\n## 🗂️ Feedback register\\n\\n| Theme | Source | Next step |\\n| - | - | - |\\n| Onboarding | Research notes | Review the first-run flow |\\n| Navigation | Team channel | Group related resources |\\n| Sharing | Support email | Clarify confirmation copy |\\n\\n## 📝 Summary\\n\\nPeople need clearer guidance at key moments. Start with onboarding, then review navigation and sharing.\\n\\n## ▶️ Follow-ups\\n\\n- Schedule user interviews for next week\",\"id\":\"feedback-tracker\",\"title\":\"Feedback tracker\"},{\"followUp\":{\"preparingLabel\":\"Getting your release notes ready…\",\"questions\":[{\"answerLabel\":\"Product\",\"options\":[],\"question\":\"What product are these release notes for?\"},{\"options\":[],\"question\":\"Which release or date range should they cover?\",\"answerLabel\":\"Release or date range\"}],\"submitLabel\":\"Create release notes\"},\"id\":\"release-notes\",\"previewMarkdown\":\"## 🆕 New\\n\\n- New capabilities and who can use them\\n\\n## 🏆 Improvements\\n\\n- Changes to existing workflows\\n\\n## 🛠️ Fixes\\n\\n- Resolved issues and their impact\\n\\n## 🌐 Availability\\n\\n- Supported platforms, rollout status, and known limitations.\\n\\n## 🔗 Sources\\n\\n- Links to sources\",\"title\":\"Release notes\",\"prompt\":\"Check my relevant connected apps and create release notes. Ask which project I would like to create release notes for.\",\"prefillPrompt\":\"Help me write release notes on this Page. Check relevant conversations and connected apps you can access for confirmed changes and limitations. Ask which release I mean if it’s unclear, and don’t add unconfirmed details or publish anything.\"}]},\"is_device_based\":false,\"passed\":true},\"4059756625\":{\"name\":\"4059756625\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":5,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"passed\":false},\"4168530037\":{\"name\":\"4168530037\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"url\":\"https://developers.openai.com/codex/app/chrome-extension\"},\"is_device_based\":false,\"passed\":false},\"4227172377\":{\"name\":\"4227172377\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"3640552975\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":4,\"id_type\":\"userID\",\"value\":{\"plus_pricing_default_tab\":\"business\",\"plus_pricing_page_surface\":\"unified\"},\"is_device_based\":false,\"passed\":false},\"4277823746\":{\"name\":\"4277823746\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"domains\":[],\"url_patterns\":[\"^https://meet\\\\.google\\\\.com/[a-z]{3}-[a-z]{4}-[a-z]{3}(?:[/?#]|$)\"]},\"is_device_based\":false,\"passed\":false}},\"layer_configs\":{\"67629032\":{\"name\":\"67629032\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"3623112901\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":180,\"value\":{\"homework_helper_trigger_mode\":\"tool_prompt\",\"homework_helper_classifier_threshold\":0.5,\"is_u18_ai_service_disclaimer_enabled\":true,\"enable_image_upload_reminder\":false,\"enable_homework_helper_widget\":false,\"homework_helper_cooldown_mode\":\"explicit\",\"homework_helper_classifier_model\":\"chat-luna-ev3-gpt6-v1\",\"enable_image_upload_reminder_v2\":false,\"is_user_enabled_pepper\":true,\"onboarding_entrypoint\":\"BANNER\",\"enable_homework_helper_v2