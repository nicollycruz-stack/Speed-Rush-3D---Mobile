    </span><span class="text-codex-syntax-variable">targetX</span><span>,
    </span><span class="text-codex-syntax-literal">2.6</span><span>,
    </span><span class="text-codex-syntax-variable">dt</span><span>
  );

  </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-keyword">!</span><span class="text-codex-syntax-variable">policePositionBlocked</span><span>(</span><span class="text-codex-syntax-variable">nextX</span><span>, </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z)) {
    </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>x </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">nextX</span><span>;
  }
}

</span><span class="Comment-dh5VVn">// Mantém distância dos veículos que estejam na frente da viatura.</span><span>
</span><span class="text-codex-syntax-keyword">for</span><span> (</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">car</span><span> </span><span class="text-codex-syntax-keyword">of</span><span> </span><span class="text-codex-syntax-variable">traffic</span><span>) {
  </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">dx</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>abs(</span><span class="text-codex-syntax-variable">car</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>x </span><span class="text-codex-syntax-keyword">-</span><span> </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>x);
  </span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">dz</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">car</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">-</span><span> </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z;

  </span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">dx</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">1.95</span><span> </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>abs(</span><span class="text-codex-syntax-variable">dz</span><span>) </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">3.0</span><span>) {
    </span><span class="Comment-dh5VVn">// Impede a viatura de continuar avançando dentro do outro carro.</span><span>
    </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">car</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-literal">3.0</span><span>;
  }
}

</span><span class="Comment-dh5VVn">// A viatura se aproxima mais depressa quando o jogador está lento.</span><span>
</span><span class="Comment-dh5VVn">// Quanto mais rápido você dirige, mais difícil fica para a polícia alcançar.</span><span>
</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">catchSpeed</span><span> </span><span class="text-codex-syntax-keyword">=</span><span>
  </span><span class="text-codex-syntax-variable">speed</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">15</span><span> </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-literal">2.8</span><span> </span><span class="text-codex-syntax-keyword">:</span><span>
  </span><span class="text-codex-syntax-variable">speed</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">25</span><span> </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-literal">1.8</span><span> </span><span class="text-codex-syntax-keyword">:</span><span>
  </span><span class="text-codex-syntax-variable">speed</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">38</span><span> </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-literal">0.8</span><span> </span><span class="text-codex-syntax-keyword">:</span><span>
  </span><span class="text-codex-syntax-literal">0.15</span><span>;

</span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>max(
  </span><span class="text-codex-syntax-variable">player</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">+</span><span> </span><span class="text-codex-syntax-literal">1.9</span><span>,
  </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">-</span><span> </span><span class="text-codex-syntax-variable">catchSpeed</span><span> </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-variable">dt</span><span>
);

</span><span class="Comment-dh5VVn">// Se a viatura chegar perto o bastante, a fuga termina.</span><span>
</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">distanceToPlayer</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>abs(
  </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z </span><span class="text-codex-syntax-keyword">-</span><span> </span><span class="text-codex-syntax-variable">player</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>z
);

</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">lateralDistance</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>abs(
  </span><span class="text-codex-syntax-variable">policeGroup</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>x </span><span class="text-codex-syntax-keyword">-</span><span> </span><span class="text-codex-syntax-variable">player</span><span class="text-codex-syntax-keyword">.</span><span>position</span><span class="text-codex-syntax-keyword">.</span><span>x
);

</span><span class="text-codex-syntax-keyword">if</span><span> (</span><span class="text-codex-syntax-variable">distanceToPlayer</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">2.5</span><span> </span><span class="text-codex-syntax-keyword">&amp;&amp;</span><span> </span><span class="text-codex-syntax-variable">lateralDistance</span><span> </span><span class="text-codex-syntax-keyword">&lt;</span><span> </span><span class="text-codex-syntax-literal">1.8</span><span>) {
  </span><span class="text-codex-syntax-variable">finishGame</span><span>();
}

</span><span class="Comment-dh5VVn">// Giroflex alternando vermelho e azul.</span><span>
</span><span class="text-codex-syntax-keyword">const</span><span> </span><span class="text-codex-syntax-variable">sirenPulse</span><span> </span><span class="text-codex-syntax-keyword">=</span><span> </span><span class="text-codex-syntax-variable">Math</span><span class="text-codex-syntax-keyword">.</span><span>sin(</span><span class="text-codex-syntax-variable">elapsed</span><span> </span><span class="text-codex-syntax-keyword">*</span><span> </span><span class="text-codex-syntax-literal">13</span><span>) </span><span class="text-codex-syntax-keyword">&gt;</span><span> </span><span class="text-codex-syntax-literal">0</span><span>;

</span><span class="text-codex-syntax-variable">police</span><span class="text-codex-syntax-keyword">.</span><span>redLight</span><span class="text-codex-syntax-keyword">.</span><span>material</span><span class="text-codex-syntax-keyword">.</span><span>emissiveIntensity </span><span class="text-codex-syntax-keyword">=</span><span>
  </span><span class="text-codex-syntax-variable">sirenPulse</span><span> </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-literal">3.6</span><span> </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-literal">0.25</span><span>;

</span><span class="text-codex-syntax-variable">police</span><span class="text-codex-syntax-keyword">.</span><span>blueLight</span><span class="text-codex-syntax-keyword">.</span><span>material</span><span class="text-codex-syntax-keyword">.</span><span>emissiveIntensity </span><span class="text-codex-syntax-keyword">=</span><span>
  </span><span class="text-codex-syntax-variable">sirenPulse</span><span> </span><span class="text-codex-syntax-keyword">?</span><span> </span><span class="text-codex-syntax-literal">0.25</span><span> </span><span class="text-codex-syntax-keyword">:</span><span> </span><span class="text-codex-syntax-literal">3.6</span><span>;</span></code></pre></div></div></div><button class="group/scroll-to-bottom cursor-interaction absolute z-30 flex h-8 w-8 translate-x-1/2 items-center justify-center rounded-full border border-default bg-surface bg-clip-padding text-secondary transition-opacity duration-basic ease-in-out end-1/2 print:hidden pointer-events-none opacity-0 bottom-4" aria-hidden="true" aria-label="Rolar até o final" tabindex="-1" type="button"><svg aria-hidden="true" class="Icon-X4VkKC text-default" focusable="false" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><use href="/cdn/assets/icons-9df9ab66b410511a.svg#arrow-down-lg-light-20" fill="currentColor"></use></svg></button></div></div></div></div><h2 class="TextBase-hXhSqg Title-HRvkwB" data-d-text-flow="" data-d-component="title" data-d-size="lg" data-d-weight="semibold">2. Sobre a viatura ficar mais realista</h2><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text">A função <code class="Code-kbs71c" data-d-component="code">createPoliceCar(x, z)</code> que te passei antes melhora a aparência, mas ainda é um modelo construído com formas geométricas. Para ficar <span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline="">realmente mais próxima de uma viatura real</span>, com carroceria curva, portas, faróis detalhados e proporções naturais, o melhor próximo passo é carregar um modelo 3D <code class="Code-kbs71c" data-d-component="code">.glb</code> de uma viatura e manter o código de perseguição separado dele.</p><p class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text"><span class="TextBase-hXhSqg Text-lIMP0_" data-d-text-flow="" data-d-component="text" data-d-default-strong="" data-d-inline="">Atenção:</span> esse código melhora a lógica, mas não é um sistema físico completo. A colisão usa margens aproximadas; precisamos testar o jogo para confirmar que a viatura não atravessa carros durante mudanças rápidas de faixa.</p></div></div></div></div></div></div></div></div><span hidden=""></span></div></div><div class="mt-1.5 flex turn-action-controls min-h-5 min-w-0 max-w-(--thread-content-max-width) flex-wrap items-center justify-start gap-0.5 browser:-ms-0.5 browser:mt-3 electron:-translate-x-1 extension:-translate-x-1.5 [&amp;_button]:focus-visible:ring-2 [&amp;_button]:focus-visible:ring-ring [&amp;_button]:focus-visible:ring-offset-0 [--side-tooltip:bottom]"><div class="flex min-h-5 min-w-0 flex-wrap items-center gap-0.5 browser:gap-0"><span data-state="closed" class="contents"><button type="button" class="no-drag cursor-interaction items-center select-none disabled:cursor-default aria-disabled:cursor-default focus:outline-hidden disabled:opacity-40 aria-disabled:opacity-40 focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-0 whitespace-nowrap flex border gap-1 rounded-full electron:rounded-md text-tertiary not-disabled:not-aria-disabled:hover:bg-primary-ghost-hover data-[state=open]:bg-primary-ghost-hover border-transparent electron:p-1 electron:[&amp;&gt;svg]:icon-sm flex items-center justify-center p-0.5" aria-label="Copiar"><svg width="21" height="21" viewBox="0 0 21 21" fill="none" xmlns="http://www.w3.org/2000/svg" class="icon-xs"><path d="M13.468 11.1216C13.468 10.4107 13.468 9.91717 13.4367 9.53369C13.4137 9.25191 13.3758 9.0622 13.3244 8.91846L13.2687 8.78858C13.1148 8.48652 12.8803 8.23344 12.593 8.05713L12.466 7.98584C12.308 7.90546 12.0963 7.84854 11.7209 7.81787C11.3374 7.78656 10.8439 7.78662 10.133 7.78662H7.29999C6.58895 7.78662 6.09562 7.78654 5.7121 7.81787C5.43015 7.84091 5.24064 7.87